<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.medicare.controllers.DashboardPatientController">
    <left>
        <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #1e3a8a;">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>
            <VBox alignment="CENTER_LEFT" prefHeight="60.0">
                <Label fx:id="nameLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="User Name" />
                <Label fx:id="emailLabel" style="-fx-font-size: 12px; -fx-text-fill: #93c5fd;" text="user@email.com" />
            </VBox>
            <VBox VBox.vgrow="ALWAYS">
                <Button fx:id="btnAccueil" onAction="#onAccueilClick" styleClass="nav-button" text="Accueil">
                    <graphic>
                        <FontIcon iconLiteral="fas-home" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="btnRendezvous" onAction="#onRendezvousClick" styleClass="nav-button" text="Mes Rendez-vous">
                    <graphic>
                        <FontIcon iconLiteral="fas-calendar-alt" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="btnDon" onAction="#onDonClick" styleClass="nav-button" text="Faire un don">
                    <graphic>
                        <FontIcon iconLiteral="fas-heart" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="btnProduits" onAction="#onProduitsClick" styleClass="nav-button" text="Nos Produits">
                    <graphic>
                        <FontIcon iconLiteral="fas-shopping-cart" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="btnPartenariats" onAction="#onPartenariatsClick" styleClass="nav-button" text="Partenariats">
                    <graphic>
                        <FontIcon iconLiteral="fas-handshake" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="btnCollaborations" onAction="#onCollaborationsClick" styleClass="nav-button" text="Collaborations">
                    <graphic>
                        <FontIcon iconLiteral="fas-users" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="btnForum" onAction="#onForumClick" styleClass="nav-button" text="Forum">
                    <graphic>
                        <FontIcon iconLiteral="fas-comments" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button fx:id="btnBecomeDoctor" onAction="#onBecomeDoctorClick" styleClass="nav-button-special" text="Devenir Medecin">
                    <graphic>
                        <FontIcon iconLiteral="fas-user-md" styleClass="nav-icon" />
                    </graphic>
                </Button>
            </VBox>
            <Button fx:id="btnLogout" onAction="#onLogoutClick" styleClass="nav-button-logout" text="Deconnexion">
                <graphic>
                    <FontIcon iconLiteral="fas-sign-out-alt" styleClass="nav-icon" />
                </graphic>
            </Button>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f3f4f6;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </StackPane>
    </center>
</BorderPane>