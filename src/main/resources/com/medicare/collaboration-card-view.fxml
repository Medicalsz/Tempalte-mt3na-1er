<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="card" alignment="CENTER" styleClass="partner-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.medicare.controllers.CollaborationCardController">
    <children>
        <ImageView fx:id="partnerImageView" fitHeight="100.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
        <VBox alignment="CENTER_LEFT" spacing="4.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label fx:id="titleLabel" styleClass="card-title" text="Titre de la collaboration" />
                <Label fx:id="partnerNameLabel" styleClass="card-subtitle" text="Nom du partenaire" />
                <Label fx:id="dateLabel" styleClass="card-meta" text="Date" />
                <Label fx:id="statusLabel" styleClass="card-status" text="Statut" />
            </children>
        </VBox>
    </children>
</VBox>
