<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.medicare.controllers.LoginController"
           stylesheets="@css/theme.css">

    <!-- Background matching welcome page -->
    <VBox style="-fx-background-color: #f0f4f8;"
          alignment="CENTER" prefWidth="900" prefHeight="720"/>

    <!-- Login card -->
    <VBox alignment="CENTER" spacing="0" maxWidth="420"
          styleClass="card" style="-fx-padding: 40;">

        <!-- Logo -->
        <HBox alignment="CENTER" spacing="6" style="-fx-padding: 0 0 10 0;">
            <Label text="🏥" style="-fx-font-size: 28;"/>
            <Label text="Medicare" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>
        </HBox>

        <Label text="Bienvenue sur Medicare"
               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1a73e8; -fx-padding: 0 0 4 0;"/>
        <Label text="Connectez-vous à votre compte"
               style="-fx-font-size: 13; -fx-text-fill: #757575; -fx-padding: 0 0 24 0;"/>

        <!-- Previous Login Card for Session Management -->
        <Button fx:id="previousLoginCard" onAction="#onUsePreviousLogin" prefWidth="340"
                visible="false" managed="false"
                style="-fx-background-color: #e5e7eb; -fx-background-radius: 16; -fx-cursor: hand; -fx-padding: 14 18; -fx-border-radius: 16; -fx-margin-bottom: 20px;">
            <graphic>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <ImageView fx:id="previousLoginAvatar" fitWidth="46" fitHeight="46" pickOnBounds="true" preserveRatio="false"/>
                    <VBox spacing="3" alignment="CENTER_LEFT">
                        <Label fx:id="previousLoginTitle" text="Login as user"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Label fx:id="previousLoginName" text=""
                               style="-fx-font-size: 12px; -fx-text-fill: #4b5563;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text=">"
                           style="-fx-font-size: 18px; -fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                </HBox>
            </graphic>
        </Button>

        <VBox style="-fx-padding: 0 0 16 0;" spacing="16">
            <!-- Email -->
            <VBox spacing="4" maxWidth="340">
                <Label text="EMAIL" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="votre@email.com" onAction="#onLoginClick"
                           styleClass="text-field-medicare" prefWidth="340"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="4" maxWidth="340">
                <Label text="MOT DE PASSE" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="••••••••" onAction="#onLoginClick"
                               styleClass="text-field-medicare" prefWidth="340"/>
            </VBox>
        </VBox>

        <!-- Forgot password -->
        <HBox alignment="CENTER_RIGHT" maxWidth="340" style="-fx-padding: 0 0 20 0;">
            <Hyperlink text="Mot de passe oublié ?"
                       style="-fx-font-size: 12; -fx-text-fill: #1a73e8;"/>
        </HBox>

        <!-- Error label -->
        <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="340"
               style="-fx-text-fill: #B71C1C; -fx-font-size: 12; -fx-padding: 0 0 6 0;" visible="false"/>

        <!-- reCAPTCHA widget (injected programmatically) -->
        <VBox fx:id="captchaContainer" prefWidth="340" prefHeight="68" alignment="CENTER"
              style="-fx-padding: 0 0 8 0;"/>

        <!-- Login button - styled like Welcome page "Connexion" button -->
        <Button fx:id="loginButton" text="Connexion" onAction="#onLoginClick"
                styleClass="btn-blue" prefWidth="340" prefHeight="44"/>

        <!-- Divider -->
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 18 0;">
            <Separator prefWidth="140"/>
            <Label text="ou" style="-fx-text-fill: #9E9E9E; -fx-font-size: 12;"/>
            <Separator prefWidth="140"/>
        </HBox>

        <!-- GOOGLE AUTH BUTTON -->
        <Button fx:id="googleBtn" onAction="#handleGoogleLogin"
                prefWidth="340" prefHeight="44" styleClass="btn-google">
            <graphic>
                <HBox spacing="10" alignment="CENTER" prefWidth="290">
                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                        <image><Image url="@images/google-icon.png"/></image>
                    </ImageView>
                    <Label text="Continuer avec Google"
                           style="-fx-font-size: 14; -fx-text-fill: #3C4043; -fx-font-weight: 500;"/>
                </HBox>
            </graphic>
        </Button>

        <!-- Biometric / Fingerprint login — shown only when biometric is set up for this email -->
        <Button fx:id="fingerprintBtn" onAction="#onFingerprintLogin" prefWidth="340" prefHeight="44"
                visible="false" managed="false"
                style="-fx-background-color: #e8f0fe; -fx-text-fill: #1a73e8;
                       -fx-background-radius: 8; -fx-border-color: #a8c7fa;
                       -fx-border-width: 1.5; -fx-border-radius: 8;
                       -fx-cursor: hand; -fx-padding: 10; -fx-font-size: 13;">
            <graphic>
                <HBox spacing="10" alignment="CENTER" prefWidth="290">
                    <Label text="☝️" style="-fx-font-size: 18;"/>
                    <Label text="Se connecter par empreinte digitale"
                           style="-fx-font-size: 13; -fx-text-fill: #1a73e8; -fx-font-weight: bold;"/>
                </HBox>
            </graphic>
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Button>

        <!-- Créer un compte button - styled like Welcome page button -->
        <Button text="Créer un compte" onAction="#onGoToRegister"
                styleClass="btn-blue-outline" prefWidth="340" prefHeight="44">
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Button>

        <HBox alignment="CENTER" style="-fx-padding: 14 0 0 0;">
            <Hyperlink text="Retour à l'accueil" onAction="#onGoToAccueil"
                       style="-fx-font-size: 12px; -fx-text-fill: #1a73e8;"/>
        </HBox>
    </VBox>
</StackPane>
