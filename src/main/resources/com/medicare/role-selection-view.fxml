<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.medicare.controllers.RoleSelectionController"
      alignment="CENTER" spacing="0"
      prefWidth="700" prefHeight="520"
      style="-fx-background-color: #FAFAFA;"
      stylesheets="@css/theme.css">

    <!-- Top gradient accent bar -->
    <HBox prefHeight="5"
          style="-fx-background-color: linear-gradient(to right, #C2185B 0%, #E91E63 50%, #43A047 100%);"/>

    <!-- Main content -->
    <VBox alignment="CENTER" spacing="32" VBox.vgrow="ALWAYS">
        <padding><Insets top="44" right="64" bottom="44" left="64"/></padding>

        <!-- Header -->
        <VBox alignment="CENTER" spacing="8">
            <Label text="🏥  Medicare"
                   style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #C2185B;"/>
            <Label text="Qui êtes-vous ?"
                   style="-fx-font-size: 21; -fx-font-weight: bold; -fx-text-fill: #212121;"/>
            <Label text="Choisissez votre type de compte pour personnaliser votre expérience"
                   style="-fx-font-size: 13; -fx-text-fill: #9E9E9E;"
                   wrapText="true" alignment="CENTER" maxWidth="440"/>
        </VBox>

        <!-- Role cards row -->
        <HBox spacing="28" alignment="CENTER">

            <!-- Patient card -->
            <VBox fx:id="patientCard" alignment="CENTER" spacing="14"
                  prefWidth="216" prefHeight="274"
                  onMouseClicked="#selectPatient"
                  onMouseEntered="#onPatientHover"
                  onMouseExited="#onPatientExit"
                  style="-fx-background-color: white; -fx-background-radius: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 14, 0, 0, 4);
                         -fx-padding: 28 20; -fx-cursor: hand;
                         -fx-border-color: #F48FB1; -fx-border-width: 2; -fx-border-radius: 20;">
                <Label text="👤" style="-fx-font-size: 50;"/>
                <Label text="Patient"
                       style="-fx-font-size: 19; -fx-font-weight: bold; -fx-text-fill: #C2185B;"/>
                <VBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="✓   Prendre des rendez-vous"
                           style="-fx-font-size: 12; -fx-text-fill: #555;"/>
                    <Label text="✓   Suivre vos médicaments"
                           style="-fx-font-size: 12; -fx-text-fill: #555;"/>
                    <Label text="✓   Historique médical"
                           style="-fx-font-size: 12; -fx-text-fill: #555;"/>
                </VBox>
                <Button text="Choisir Patient" onAction="#selectPatient"
                        style="-fx-background-color: #C2185B; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 12;
                               -fx-padding: 9 22; -fx-cursor: hand; -fx-font-size: 12;"/>
            </VBox>

            <!-- Divider -->
            <Label text="ou"
                   style="-fx-font-size: 15; -fx-text-fill: #BDBDBD; -fx-font-weight: bold;"/>

            <!-- Medecin card -->
            <VBox fx:id="medecinCard" alignment="CENTER" spacing="14"
                  prefWidth="216" prefHeight="274"
                  onMouseClicked="#selectMedecin"
                  onMouseEntered="#onMedecinHover"
                  onMouseExited="#onMedecinExit"
                  style="-fx-background-color: white; -fx-background-radius: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 14, 0, 0, 4);
                         -fx-padding: 28 20; -fx-cursor: hand;
                         -fx-border-color: #A5D6A7; -fx-border-width: 2; -fx-border-radius: 20;">
                <Label text="🩺" style="-fx-font-size: 50;"/>
                <Label text="Médecin"
                       style="-fx-font-size: 19; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                <VBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="✓   Gérer vos patients"
                           style="-fx-font-size: 12; -fx-text-fill: #555;"/>
                    <Label text="✓   Gérer vos rendez-vous"
                           style="-fx-font-size: 12; -fx-text-fill: #555;"/>
                    <Label text="✓   Disponibilité en ligne"
                           style="-fx-font-size: 12; -fx-text-fill: #555;"/>
                </VBox>
                <Button text="Choisir Médecin" onAction="#selectMedecin"
                        style="-fx-background-color: #2E7D32; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 12;
                               -fx-padding: 9 22; -fx-cursor: hand; -fx-font-size: 12;"/>
            </VBox>
        </HBox>

        <!-- Medecin verification notice -->
        <HBox alignment="CENTER" spacing="6"
              style="-fx-background-color: #FFF3E0; -fx-background-radius: 10; -fx-padding: 8 18;">
            <Label text="⚠️" style="-fx-font-size: 13;"/>
            <Label text="Le compte Médecin nécessite une vérification par notre équipe médicale avant activation."
                   style="-fx-font-size: 12; -fx-text-fill: #E65100;"
                   wrapText="true" maxWidth="400"/>
        </HBox>
    </VBox>
</VBox>
