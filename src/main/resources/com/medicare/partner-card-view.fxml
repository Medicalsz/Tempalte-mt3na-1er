<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="8" styleClass="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <ImageView fx:id="partnerImageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
        <Label fx:id="titleLabel" styleClass="card-title" text="Partner Name" />
        <Label fx:id="partnerNameLabel" styleClass="card-subtitle" text="Partner Type" />
        <Button fx:id="detailButton" onAction="#onDetailClick" text="Voir les détails" />
    </children>
</VBox>
