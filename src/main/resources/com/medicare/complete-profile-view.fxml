<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="com.medicare.controllers.CompleteProfileController"
            prefWidth="900" prefHeight="620"
            stylesheets="@css/theme.css"
            style="-fx-background-color: #F5F7FA;">

    <!-- ===== TOP NAVIGATION BAR ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: white; -fx-padding: 13 24;
                     -fx-border-color: #EEEEEE; -fx-border-width: 0 0 1 0;">
            <Label text="🏥" style="-fx-font-size: 18;"/>
            <Label text="Medicare"
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #C2185B;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Notification bell with unread badge -->
            <StackPane>
                <Button fx:id="notifBtn" text="🔔" onAction="#openNotifications"
                        style="-fx-background-color: #FCE4EC; -fx-text-fill: #C2185B;
                               -fx-background-radius: 50; -fx-font-size: 15;
                               -fx-padding: 7 12; -fx-cursor: hand;
                               -fx-border-color: transparent;"/>
                <Label fx:id="notifBadge" text="0"
                       style="-fx-background-color: #C2185B; -fx-text-fill: white;
                              -fx-background-radius: 10; -fx-font-size: 9; -fx-font-weight: bold;
                              -fx-padding: 2 5; -fx-min-width: 18; -fx-alignment: CENTER;"
                       visible="false"
                       StackPane.alignment="TOP_RIGHT"
                       translateX="6" translateY="-4"/>
            </StackPane>
            <Hyperlink fx:id="skipLink" text="Passer pour l'instant" onAction="#skipProfile"
                       style="-fx-text-fill: #BDBDBD; -fx-font-size: 12; -fx-border-color: transparent;"/>
        </HBox>
    </top>

    <!-- ===== LEFT SIDEBAR ===== -->
    <left>
        <VBox spacing="16" alignment="TOP_CENTER"
              style="-fx-background-color: white; -fx-pref-width: 214; -fx-padding: 28 14;
                     -fx-border-color: #EEEEEE; -fx-border-width: 0 1 0 0;">

            <!-- Avatar circle with initials -->
            <StackPane minHeight="96" minWidth="96" maxHeight="96" maxWidth="96">
                <Circle radius="46" fill="#FCE4EC" stroke="#C2185B" strokeWidth="2.5"/>
                <ImageView fx:id="avatarImage" fitWidth="92" fitHeight="92"
                           preserveRatio="false" visible="false"/>
                <Label fx:id="avatarInitials" text="?"
                       style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #C2185B;"/>
            </StackPane>

            <!-- Name + email -->
            <VBox spacing="3" alignment="CENTER">
                <Label fx:id="nameLabel" text="..."
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #212121;"
                       wrapText="true" alignment="CENTER" maxWidth="186"/>
                <Label fx:id="emailLabel" text=""
                       style="-fx-font-size: 11; -fx-text-fill: #9E9E9E;"
                       wrapText="true" alignment="CENTER" maxWidth="186"/>
            </VBox>

            <!-- Role badge -->
            <Label fx:id="roleBadge" text="👤  PATIENT"
                   style="-fx-background-color: #FCE4EC; -fx-text-fill: #C2185B;
                          -fx-background-radius: 20; -fx-padding: 5 16;
                          -fx-font-size: 11; -fx-font-weight: bold;"/>

            <!-- Verification status badge -->
            <HBox fx:id="verifBox" spacing="6" alignment="CENTER"
                  style="-fx-background-color: #FFF3E0; -fx-background-radius: 20; -fx-padding: 6 14;">
                <Label fx:id="verifIcon" text="⏳" style="-fx-font-size: 12;"/>
                <Label fx:id="verifLabel" text="Vérification en attente"
                       style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #E65100;"
                       wrapText="true" maxWidth="130"/>
            </HBox>

            <Separator/>

            <!-- Progress indicator -->
            <VBox spacing="8" alignment="CENTER">
                <Label text="Profil complété"
                       style="-fx-font-size: 11; -fx-text-fill: #9E9E9E;"/>
                <Label fx:id="pctLabel" text="0%"
                       style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #C2185B;"/>
                <ProgressBar fx:id="progressBar" progress="0" prefWidth="176"
                             style="-fx-accent: #C2185B; -fx-pref-height: 10; -fx-background-radius: 5;"/>
            </VBox>

            <Separator/>

            <!-- Go to dashboard (visible only at 50%+) -->
            <Button fx:id="goBtn" text="Accéder au dashboard →"
                    onAction="#goDashboard" visible="false" wrapText="true"
                    prefWidth="182"
                    style="-fx-background-color: #43A047; -fx-text-fill: white;
                           -fx-background-radius: 12; -fx-font-size: 12; -fx-font-weight: bold;
                           -fx-padding: 10 14; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ===== MAIN CONTENT ===== -->
    <center>
        <VBox fx:id="tilesCenter" spacing="16" style="-fx-padding: 28 30;">

            <!-- Page title -->
            <VBox spacing="4">
                <Label text="Complétez votre profil"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #212121;"/>
                <Label text="Renseignez vos informations pour débloquer toutes les fonctionnalités"
                       style="-fx-font-size: 12; -fx-text-fill: #9E9E9E;"/>
            </VBox>

            <!-- Smart Alert Banner zone (injected by controller) -->
            <VBox fx:id="alertZone" spacing="0"/>

            <!-- Tiles section label -->
            <Label text="TOUCHEZ UNE SECTION POUR LA COMPLÉTER"
                   style="-fx-font-size: 10; -fx-text-fill: #BDBDBD; -fx-font-weight: bold;
                          -fx-padding: 4 0 0 0;"/>

            <!-- 3 x 2 Tile Grid -->
            <GridPane hgap="14" vgap="14">

                <!-- Row 0 -->
                <Button fx:id="tilePersonal" GridPane.columnIndex="0" GridPane.rowIndex="0"
                        text="👤&#10;Infos personnelles" onAction="#openPersonal"
                        prefWidth="172" prefHeight="114"
                        wrapText="true"
                        style="-fx-background-color: #FCE4EC; -fx-border-color: #F48FB1;
                               -fx-border-width: 2; -fx-border-radius: 16; -fx-background-radius: 16;
                               -fx-text-fill: #C2185B; -fx-font-size: 13; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-alignment: CENTER;"/>

                <Button fx:id="tileMedical" GridPane.columnIndex="1" GridPane.rowIndex="0"
                        text="🩺&#10;Infos médicales" onAction="#openMedical"
                        prefWidth="172" prefHeight="114"
                        wrapText="true"
                        style="-fx-background-color: #E8F5E9; -fx-border-color: #A5D6A7;
                               -fx-border-width: 2; -fx-border-radius: 16; -fx-background-radius: 16;
                               -fx-text-fill: #2E7D32; -fx-font-size: 13; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-alignment: CENTER;"/>

                <Button fx:id="tileLocation" GridPane.columnIndex="2" GridPane.rowIndex="0"
                        text="📍&#10;Localisation" onAction="#openLocation"
                        prefWidth="172" prefHeight="114"
                        wrapText="true"
                        style="-fx-background-color: #FFF3E0; -fx-border-color: #FFCC80;
                               -fx-border-width: 2; -fx-border-radius: 16; -fx-background-radius: 16;
                               -fx-text-fill: #E65100; -fx-font-size: 13; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-alignment: CENTER;"/>

                <!-- Row 1 -->
                <Button fx:id="tileContact" GridPane.columnIndex="0" GridPane.rowIndex="1"
                        text="📞&#10;Contact" onAction="#openContact"
                        prefWidth="172" prefHeight="114"
                        wrapText="true"
                        style="-fx-background-color: #FCE4EC; -fx-border-color: #F48FB1;
                               -fx-border-width: 2; -fx-border-radius: 16; -fx-background-radius: 16;
                               -fx-text-fill: #C2185B; -fx-font-size: 13; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-alignment: CENTER;"/>

                <Button fx:id="tilePhoto" GridPane.columnIndex="1" GridPane.rowIndex="1"
                        text="📷&#10;Photo de profil" onAction="#openPhoto"
                        prefWidth="172" prefHeight="114"
                        wrapText="true"
                        style="-fx-background-color: #ECEFF1; -fx-border-color: #B0BEC5;
                               -fx-border-width: 2; -fx-border-radius: 16; -fx-background-radius: 16;
                               -fx-text-fill: #546E7A; -fx-font-size: 13; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-alignment: CENTER;"/>

                <Button fx:id="tileNotif" GridPane.columnIndex="2" GridPane.rowIndex="1"
                        text="🔔&#10;Notifications" onAction="#openNotif"
                        prefWidth="172" prefHeight="114"
                        wrapText="true"
                        style="-fx-background-color: #FFF3E0; -fx-border-color: #FFCC80;
                               -fx-border-width: 2; -fx-border-radius: 16; -fx-background-radius: 16;
                               -fx-text-fill: #E65100; -fx-font-size: 13; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-alignment: CENTER;"/>
            </GridPane>

        </VBox>
    </center>

</BorderPane>
