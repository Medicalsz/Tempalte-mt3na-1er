<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="detailsContainer" alignment="TOP_LEFT" spacing="20" styleClass="details-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.medicare.controllers.CollaborationDetailsController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="20.0" />
    </padding>
    <children>
        <Button fx:id="backButton" onAction="#onBackClick" styleClass="back-button" text="Retour à la liste">
            <graphic>
                <FontIcon iconLiteral="fas-arrow-left" />
            </graphic>
        </Button>

        <HBox spacing="30" HBox.hgrow="ALWAYS">
            <ImageView fx:id="collaborationImageView" fitHeight="180.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="false" styleClass="details-image" />
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" styleClass="details-title" text="Titre de la Collaboration" wrapText="true" />
                <Label fx:id="statusLabel" styleClass="details-status" text="Statut" />
                
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="details-meta-item">
                    <FontIcon iconLiteral="fas-handshake" styleClass="details-meta-icon" />
                    <Label fx:id="partnerLabel" text="Avec: Partenaire" wrapText="true" HBox.hgrow="ALWAYS" onMouseClicked="#onPartnerClick" styleClass="link-label" />
                </HBox>
                
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="details-meta-item">
                    <FontIcon iconLiteral="fas-calendar-alt" styleClass="details-meta-icon" />
                    <Label fx:id="datesLabel" text="Du DATE au DATE" wrapText="true" HBox.hgrow="ALWAYS" />
                </HBox>
                <VBox spacing="8" styleClass="details-section" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="10.0" />
            </padding>
            <Label styleClass="details-section-title" text="Description" />
            <Label fx:id="descriptionLabel" styleClass="details-content" text="Description complète de la collaboration..." wrapText="true" />
        </VBox>

        <!-- Add to Calendar Button -->
        <VBox alignment="CENTER_LEFT" spacing="10" styleClass="details-section">
            <padding>
                <Insets top="20.0" />
            </padding>
            <Button fx:id="addToCalendarButton" onAction="#onAddToCalendarClick" styleClass="calendar-button" text="Ajouter au calendrier">
                <graphic>
                    <FontIcon iconLiteral="fas-calendar-plus" styleClass="calendar-icon" />
                </graphic>
            </Button>
        </VBox>

    </VBox>
    <VBox alignment="CENTER" spacing="5">
                <ImageView fx:id="qrCodeImageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#onQRCodeClick" styleClass="clickable-qr"/>
                <Label text="Scannez-moi" style="-fx-font-size: 10px; -fx-text-fill: #6b7280;" />
            </VBox>
        </HBox>
    </children>
</VBox>
